{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://suzy-ai.local/schema/event-0.1.json",
  "title": "SUZY//AI Event",
  "type": "object",
  "required": [
    "schema_version",
    "id",
    "kind",
    "source",
    "created_at",
    "payload"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1"
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "kind": {
      "type": "string",
      "minLength": 1
    },
    "source": {
      "type": "string",
      "minLength": 1
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "payload": {
      "type": "object"
    },
    "provenance": {
      "type": "object"
    }
  },
  "additionalProperties": true
}
