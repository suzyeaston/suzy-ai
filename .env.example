# Export these in your shell before `suzy-ai serve`; .env is not auto-loaded.
# Inference is disabled until you select a model already installed locally.
# SUZY_AI_MODEL=your-installed-local-model
SUZY_AI_INFERENCE_URL=http://127.0.0.1:11434/v1
SUZY_AI_INFERENCE_TIMEOUT=60
# Private state must be outside the source checkout.
# SUZY_AI_HOME=/absolute/private/path/suzy-ai
